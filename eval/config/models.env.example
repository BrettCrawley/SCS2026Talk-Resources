# Copy to config/models.env and fill in. Sourced by bin/run-all.sh and
# bin/run-cell.sh. Real environment variables still win, so you can override a
# single run without editing this.
#
# These strings are part of the experimental record. Changing the cheap model
# between batches turns a comparison into two different experiments, and the
# scorecard cannot tell the difference. Set them once and leave them.

# The model the programme normally runs on.
FRONTIER_MODEL="claude-opus-5"

# The tier a cost-conscious team would plausibly pick under the pressure
# PLAT-2822 describes. Not the weakest model available: the finding is about a
# plausible economy, not a straw man.
CHEAP_MODEL="claude-haiku-4-5"

# Optional caps. A dollar cap is the better guard for a batch, since a runaway
# cell costs money rather than turns.
MAX_BUDGET_USD="5"
MAX_TURNS="60"

# --- Cursor engine (run6) -----------------------------------------------------
# The model your teams actually use in Cursor. If they are on Composer, this
# cell measures current practice rather than a hypothetical.
CURSOR_MODEL="composer-2.5"

# Cursor's print mode documents stream-json. If your build accepts plain json,
# set it here after probing, because the scorecard parses it more easily.
#   agent -p "reply with ok" --output-format json 2>&1 | head -5
CURSOR_OUTPUT_FORMAT="stream-json"

# Extra arguments for the cursor engine, unquoted and word-split. Cursor's docs
# recommend an explicit permission policy for headless runs, since nobody is at
# the keyboard. Set that here once you have confirmed the flag name on your build.
CURSOR_EXTRA_ARGS=""
