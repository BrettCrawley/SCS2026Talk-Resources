# Orchestrator
PORT=8080
LOG_LEVEL=info
REDIS_URL=redis://localhost:6379

# Model provider. The enterprise endpoint is the one Data Platform contracted.
PROVIDER_ENTERPRISE_URL=https://eu.enterprise.provider.example/v1
PROVIDER_ENTERPRISE_KEY=

# Fallback used when the enterprise endpoint rate limits during peak.
# Added during the June load issues, see docs/adr/0006.
PROVIDER_FALLBACK_URL=https://api.provider.example/v1
PROVIDER_FALLBACK_KEY=

# Connectors
CONNECTORS_URL=http://assistant-connectors:8090
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
SLACK_BOT_TOKEN=
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
CONFLUENCE_BASE_URL=
CONFLUENCE_TOKEN=
SEARCH_API_KEY=

# EXPOSE_DEBUG_ROUTES=false in production. Not set by the chart.
